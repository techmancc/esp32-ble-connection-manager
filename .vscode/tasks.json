      "type": "shell",
      "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Monitor",
      "type": "shell", 
      "command": "${userHome}/.platformio/penv/Scripts/pio.exe",
      "args": ["device", "monitor"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}