# ESP32 Access Point Configuration
# ESP32 creates its own WiFi network - connect to it first!
VITE_API_BASE_URL=http://192.168.4.1
VITE_WS_URL=ws://192.168.4.1:81

# Instructions:
# 1. Upload firmware to ESP32: pio run -e esp32s3-n16r8 -t upload
# 2. Check serial monitor for network name: "ESP32-BLE-Control-XXXXXX"
# 3. Connect your device to that WiFi network (password: esp32ble)
# 4. Open http://192.168.4.1 in your browser
# 5. Or run the React client locally: npm run dev