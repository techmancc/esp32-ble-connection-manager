# ESP32 API Configuration - Direct Connection for Testing
# Direct connection to ESP32 for immediate connectivity
VITE_API_BASE_URL=http://192.168.4.1
VITE_WS_URL=ws://192.168.4.1:81

# Fallback for Access Point Mode (if auto-detection fails)
VITE_FALLBACK_API_URL=http://192.168.4.1
VITE_FALLBACK_WS_URL=ws://192.168.4.1:81

# Development
VITE_DEV_MODE=true